# Car2LEGO Environment Variables
# Copy this file to .env and fill in your values

# Required
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.lundong.ai
OPENAI_MODEL=gpt-6.1-sol
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
IMAGE_QUALITY=high
IMAGE_SIZE=1536x1024
IMAGE_TIMEOUT=300
DESIGN_WORKFLOW=assembly_v3
ASSEMBLY_TEXT_CALL_LIMIT=64
ASSEMBLY_TEXT_RETRY_ATTEMPTS=3
ASSEMBLY_MODULE_REPAIR_LIMIT=3
ASSEMBLY_REPLAN_LIMIT=2
ASSEMBLY_LEASE_SECONDS=900

# Optional
REBRICKABLE_API_KEY=
BRICKLINK_API_KEY=
BRICKLINK_API_SECRET=

# Studio paths (Windows only — for desktop automation)
STUDIO_PATH=D:\lego\Studio 2.0\Studio.exe
PARTDESIGNER_PATH=D:\lego\Studio 2.0\patcher2\Patcher.exe

# Database
DATABASE_URL=postgresql+asyncpg://car2lego:car2lego@localhost:5432/car2lego
REDIS_URL=redis://localhost:6379/0
STORAGE_PATH=./storage
DEBUG=true
